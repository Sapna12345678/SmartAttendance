html
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Generate Attendance QR</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <style>

        body {
            background: #f4f7fb;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background: #182848;
        }

        .main-card {
            max-width: 700px;
            margin: 50px auto;
            background: white;
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.10);
        }

        .qr-box {
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 30px auto;
            min-height: 320px;
        }

        #qrcode {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        #qrcode img {
            margin: auto;
            padding: 10px;
            background: white;
            border: 1px solid #ddd;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.12);
        }

        .session-box {
            background: #f1f4f9;
            border-radius: 10px;
            padding: 12px;
            word-break: break-all;
            font-size: 13px;
            color: #555;
        }

        .btn-large {
            padding: 12px 25px;
            font-size: 17px;
        }

        .url-box {
            background: #e8f5e9;
            border-radius: 10px;
            padding: 12px;
            word-break: break-all;
            font-size: 13px;
            color: #2e7d32;
            margin-top: 15px;
        }

        .timer {
            font-size: 20px;
            font-weight: bold;
            color: #dc3545;
            margin-top: 15px;
        }

    </style>

</head>


<body>


<!-- ================= NAVBAR ================= -->

<nav class="navbar navbar-dark">

    <div class="container">

        <a class="navbar-brand" href="/">

            <i class="bi bi-qr-code-scan"></i>

            Smart Attendance

        </a>


        <a
            href="/"
            class="btn btn-light btn-sm"
        >

            <i class="bi bi-house"></i>

            Dashboard

        </a>

    </div>

</nav>


<!-- ================= MAIN ================= -->

<div class="container">

    <div class="main-card">


        <i
            class="bi bi-qr-code"
            style="font-size: 55px;"
        ></i>


        <h1 class="mt-3">

            Attendance QR Code

        </h1>


        <p class="text-muted">

            Students can scan this QR code to mark their attendance.

        </p>


        <!-- ================= QR CODE ================= -->

        <div class="qr-box">

            <div id="qrcode"></div>

        </div>


        <!-- ================= TIMER ================= -->

        <div class="timer">

            QR expires in:
            <span id="timer">60</span>
            seconds

        </div>


        <!-- ================= SESSION ACTIVE ================= -->

        <div class="alert alert-success mt-3">

            <i class="bi bi-check-circle"></i>

            <strong>
                Attendance Session Active
            </strong>

        </div>


        <!-- ================= SESSION ID ================= -->

        <p class="text-muted mb-2">

            Session ID

        </p>


        <div class="session-box">

            {{ session_id }}

        </div>


        <!-- ================= QR URL ================= -->

        <p class="text-muted mt-4 mb-2">

            QR Scan URL

        </p>


        <div class="url-box">

            <span id="attendanceUrl"></span>

        </div>


        <!-- ================= BUTTONS ================= -->

        <div class="mt-4">

            <a
                href="/projector/"
                class="btn btn-success btn-large me-2"
            >

                <i class="bi bi-display"></i>

                Projector Mode

            </a>


            <a
                href="/"
                class="btn btn-outline-secondary btn-large"
            >

                <i class="bi bi-arrow-left"></i>

                Dashboard

            </a>

        </div>


    </div>

</div>


<!-- ================= QR CODE LIBRARY ================= -->

<script
    src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js">
</script>


<script>

    // =====================================================
    // HTTPS SERVER ADDRESS
    // =====================================================

    const baseURL = "https://10.93.44.160:8000";


    // =====================================================
    // SESSION ID FROM DJANGO
    // =====================================================

    const sessionId = "{{ session_id }}";


    // =====================================================
    // CREATE STUDENT SCAN URL
    // =====================================================

    const attendanceURL =
        baseURL +
        "/scan/?session=" +
        encodeURIComponent(sessionId);


    // =====================================================
    // SHOW URL
    // =====================================================

    document.getElementById(
        "attendanceUrl"
    ).textContent = attendanceURL;


    // =====================================================
    // GENERATE QR CODE
    // =====================================================

    new QRCode(
        document.getElementById("qrcode"),
        {
            text: attendanceURL,
            width: 300,
            height: 300,
            colorDark: "#000000",
            colorLight: "#ffffff",
            correctLevel: QRCode.CorrectLevel.H
        }
    );


    // =====================================================
    // 60 SECOND COUNTDOWN
    // =====================================================

    const expiresAt =
        new Date(
            "{{ expires_at|date:'c' }}"
        ).getTime();


    function updateTimer() {

        const now =
            new Date().getTime();

        const remaining =
            Math.max(
                0,
                Math.ceil(
                    (expiresAt - now) / 1000
                )
            );


        document.getElementById(
            "timer"
        ).textContent = remaining;


        if (remaining <= 0) {

            document.getElementById(
                "timer"
            ).textContent = "Expired";

        }

    }


    updateTimer();


    setInterval(
        updateTimer,
        1000
    );

</script>


</body>

</html>

